# Tiffany Fès — clés et réglages
# Copiez ce fichier vers .env si vous repartez de zéro.
# Ne commitez jamais le fichier .env.

# Adresse publique du site, sans slash final.
# En local : http://localhost:3000
# En production : https://votre-domaine.ma
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
# Project Settings → API
# Laissez vide pour le mode démo (catalogue enregistré dans data/catalog.json).
# Dès que les trois premières valeurs utiles sont remplies, le site passe sur Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Téléphone affiché sur le site et lien WhatsApp (chiffres seulement, indicatif compris).
# Exemple : 2126XXXXXXXX
# Laissez vide pour masquer les boutons.
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=

# --- Mode démo, utilisé TANT QUE Supabase est vide ---
# Changez le mot de passe avant toute mise en ligne sans Supabase.
DEMO_ADMIN_EMAIL=admin@tiffany.ma
DEMO_ADMIN_PASSWORD=changez-moi
DEMO_SESSION_SECRET=changez-moi-en-une-longue-chaine-aleatoire
